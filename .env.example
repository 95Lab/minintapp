# Optional canonical origin; set on a reverse-proxied deployment, without a trailing slash.
APP_ORIGIN=

# OpenAI is the only AI provider. Missing key disables generation; no silent mock fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Empty for models without reasoning support; otherwise minimal | low | medium | high.
OPENAI_REASONING_EFFORT=low
GENERATION_DEADLINE_MS=18000

# Reserved for the future Supabase repository. Server key must never be NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

PRESENTER_KEY=
IP_HASH_SALT=
ENABLE_SIMULATE=0
CSP_REPORT_ONLY=0
LIVE_DATA=off
