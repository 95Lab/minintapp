# Non-secret configuration only. Actual credentials live in ~/.config/ai-secrets/api.env.
POSTGRES_SANDBOX_BIND_IP=172.30.240.1
MININTAPP_OBJECTSTORE_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
# .env.control
# APPS_DOMAIN=minintapp.io.vn
# WORKER_AGENT_URLS=http://172.30.240.1:19090
# MAX_ACTIVE_APPS=3
# .env.worker
# systemd loads /root/.config/ai-secrets/api.env through EnvironmentFile.
# RUNTIME_POSTGRES_URL=postgresql://172.30.240.1:15432
# WORKER_ID=vm-demo-01
# WORKER_CAPACITY=3
# WORKER_AGENT_URL=http://172.30.240.1:19090
# WORKER_BIND_ADDRESS=172.30.240.1
# IS_EDGE_WORKER=true
# TRAEFIK_ROUTES_DIR=/opt/minintapp/routes
# INGRESS_HOSTNAME=ingress.minintapp.io.vn
# DNS_AUTOMATION_APPROVED=false
# S3_BUCKET=minintapp-artifacts
# S3_ENDPOINT=http://127.0.0.1:19000
# OPENAI_MODEL=gpt-5-mini
# GENERATION_DEADLINE_MS=60000
# For extra workers, inject DATABASE_URL/REDIS_URL for the private control services,
# RUNTIME_POSTGRES_URL for the reachable app PostgreSQL endpoint,
# WORKER_GATEWAY_URL and allowlisted WORKER_GATEWAY_URLS on the edge worker.
# Central secrets contain OPENAI_API_KEY, CLOUDFLARE_API_TOKEN,
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_ZONE_ID, DATABASE_URL, REDIS_URL,
# POSTGRES_PASSWORD, REDIS_PASSWORD, WORKER_TOKEN, IP_HASH_SALT,
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY. Never commit their values.
