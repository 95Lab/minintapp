# Non-secret configuration only. Actual credentials live in ~/.config/ai-secrets/api.env.
MININTAPP_OBJECTSTORE_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
# .env.control
# APPS_DOMAIN=minintapp.io.vn
# WORKER_AGENT_URLS=http://172.30.240.1:19090
# MAX_ACTIVE_APPS=3
# .env.worker
# CENTRAL_API_ENV_FILE=/root/.config/ai-secrets/api.env
# WORKER_ID=vm-demo-01
# WORKER_CAPACITY=3
# WORKER_AGENT_URL=http://172.30.240.1:19090
# WORKER_BIND_ADDRESS=172.30.240.1
# IS_EDGE_WORKER=true
# TRAEFIK_ROUTES_DIR=/opt/minintapp/routes
# INGRESS_HOSTNAME=ingress.minintapp.io.vn
# DNS_AUTOMATION_APPROVED=false
# S3_BUCKET=minintapp-artifacts
# S3_ENDPOINT=http://127.0.0.1:19000
# OPENAI_MODEL=gpt-5-mini
# GENERATION_DEADLINE_MS=60000
# For extra workers, configure private DATABASE_HOST/PORT, REDIS_HOST/PORT,
# WORKER_GATEWAY_URL and allowlisted WORKER_GATEWAY_URLS on the edge worker.
# Central secrets additionally contain MININTAPP_POSTGRES_PASSWORD,
# MININTAPP_REDIS_PASSWORD, MININTAPP_WORKER_TOKEN, MININTAPP_SIGNING_SECRET,
# MININTAPP_S3_ACCESS_KEY_ID and MININTAPP_S3_SECRET_ACCESS_KEY.
