# Copy to .env.platform, chmod 600; use independent random passwords.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# .env.control (inside the platform web container)
# PLATFORM_ROLE=control
# DATABASE_URL=postgresql://minintapp:PASSWORD@postgres:5432/minintapp
# REDIS_URL=redis://:PASSWORD@redis:6379
# RUNTIME_IMAGE=ghcr.io/95lab/minintapp@sha256:DIGEST
# APPS_DOMAIN=minintapp.io.vn
# WORKER_AGENT_URLS=http://172.30.240.1:19090
# WORKER_TOKEN=RANDOM_64_HEX
# MAX_ACTIVE_APPS=3
#
# .env.worker (root-owned host environment, never passed to app sandboxes)
# DATABASE_URL=postgresql://minintapp:PASSWORD@127.0.0.1:15432/minintapp
# REDIS_URL=redis://:PASSWORD@127.0.0.1:16379
# WORKER_ID=vm-demo-01
# WORKER_CAPACITY=3
# WORKER_AGENT_URL=http://172.30.240.1:19090
# WORKER_BIND_ADDRESS=172.30.240.1
# WORKER_TOKEN=SAME_CONTROL_TOKEN
# TRAEFIK_ROUTES_DIR=/opt/minintapp/routes
# CENTRAL_API_ENV_FILE=/root/.config/ai-secrets/api.env
# DNS_AUTOMATION_APPROVED=false
# INGRESS_HOSTNAME=ingress.minintapp.io.vn
# OPENAI_MODEL=gpt-5-mini
# S3_BUCKET=minintapp-artifacts
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
