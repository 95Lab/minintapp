# Included beside existing platform vhost. Configure a valid wildcard origin certificate first.
# Never replace existing nginx.conf or the platform's exact hostname vhost.
server {
    listen 443 ssl;
    server_name "~^[a-f0-9]{24}\.minintapp\.io\.vn$";
    ssl_certificate /etc/letsencrypt/live/minintapp-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/minintapp-wildcard/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:18081;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
