{
  "name": "minintapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "env:local": "node scripts/setup-local-env.mjs",
    "env:check": "node --env-file=.env.local scripts/check-env.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start:standalone": "node scripts/start-standalone.mjs",
    "smoke:deploy": "node scripts/deploy-smoke.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "openai": "^7.46.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}
